#include <bits/stdc++.h>
using namespace std;

void sieve(int n) {
    vector<bool> isPrime(n + 1, true);
    isPrime[0] = isPrime[1] = false;

    for (int i = 2; i * i <= n; i++) {
        if (isPrime[i]) {
            for (int j = i * i; j <= n; j += i) {
                isPrime[j] = false;
            }
        }
    }

    cout << "Prime numbers from 1 to " << n << " are:\n";
    for (int i = 2; i <= n; i++) {
        if (isPrime[i]) cout << i << " ";
    }
    cout << "\n";
}

int main() {
    int n;
    cout << "Enter N: ";
    cin >> n;
    sieve(n);
    return 0;
}
