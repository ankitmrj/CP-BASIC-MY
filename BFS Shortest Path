class Solution {
public:
    vector<int> shortestPath(int N, vector<vector<int>>& edges, int src) {
        vector<vector<int>> graph(N);
        for (auto &e : edges) graph[e[0]].push_back(e[1]), graph[e[1]].push_back(e[0]);

        vector<int> dist(N, 1e9);
        queue<int> q;
        dist[src] = 0;
        q.push(src);

        while (!q.empty()) {
            int u = q.front(); q.pop();
            for (int v : graph[u]) {
                if (dist[v] > dist[u] + 1) {
                    dist[v] = dist[u] + 1;
                    q.push(v);
                }
            }
        }
        for (int &d : dist) if (d == 1e9) d = -1;
        return dist;
    }
};
