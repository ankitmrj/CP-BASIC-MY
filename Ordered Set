Ordered Set

#include <ext/pb_ds/assoc_container.hpp>
#include <ext/pb_ds/tree_policy.hpp>
using namespace __gnu_pbds;

typedef tree<
    int,
    null_type,
    less<int>,
    rb_tree_tag,
    tree_order_statistics_node_update
> ordered_set;
ordered_set s;  // o(log n)
s.insert(5);
s.insert(2);
s.insert(10);

s.erase(5); //o(log n)

if (s.find(2) != s.end()) {
    // exists  O(log n)
}

1. find_by_order(k)

👉 Returns iterator to k-th smallest element (0-based)
cout << *s.find_by_order(0);  // smallest
cout << *s.find_by_order(2);  // 3rd smallest

2. order_of_key(x)

👉 Returns count of elements strictly less than x
cout << s.order_of_key(10);

